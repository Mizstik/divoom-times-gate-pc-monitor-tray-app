{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MZ TGM 2",
  "version": "0.1.0",
  "identifier": "app.mz.mztgm2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MZ TGM 2 — Times Gate PC Monitor",
        "width": 760,
        "height": 510,
        "resizable": false,
        "minimizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
